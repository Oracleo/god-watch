// ============================================================
// God Watch — Prisma Schema (Supabase PostgreSQL)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// Auth.js models (Google OAuth)
// ------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  tasks            Task[]
  notes            Note[]
  activityLogs     ActivityLog[]
  userAchievements UserAchievement[]
  settings         Settings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------
// Domain models
// ------------------------------------------------------------

/// A user-defined habit / checklist item.
model Task {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#64748b")
  order     Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskStatuses TaskStatus[]

  @@index([userId, archived, order])
  @@index([userId, order])
}

enum Status {
  PENDING
  COMPLETED
  FAILED
  MISSED
}

/// One cell in the grid: status of a task on a particular date.
/// `date` is normalized as yyyy-MM-dd (UTC) to avoid timezone drift.
model TaskStatus {
  id        String   @id @default(cuid())
  taskId    String
  date      String // normalized yyyy-MM-dd (UTC)
  status    Status   @default(PENDING)
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
  @@index([date])
  @@index([taskId])
}

/// Autosaved note attached to a specific date.
model Note {
  id        String   @id @default(cuid())
  userId    String
  date      String // normalized yyyy-MM-dd
  content   String   @db.Text @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

enum ActivityType {
  TASK_CREATED
  TASK_RENAMED
  TASK_DELETED
  TASK_ARCHIVED
  TASK_UNARCHIVED
  TASK_REORDERED
  TASK_COLOR_CHANGED
  STATUS_CHANGED
  LOGIN
  LOGOUT
  SETTINGS_CHANGED
  NOTE_UPDATED
  ACHIEVEMENT_UNLOCKED
}

/// Full audit trail of user actions.
model ActivityLog {
  id        String       @id @default(cuid())
  userId    String
  type      ActivityType
  metadata  Json? // flexible context: {taskId, date, from, to, noteId, ...}
  ip        String?
  userAgent String?      @db.Text
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// Inspirational quotes shown on month separators & dashboard.
model Quote {
  id     String @id @default(cuid())
  text   String @db.Text
  author String
}

/// Badges / achievements definitions.
model Achievement {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  description      String
  icon             String
  criteria         Json // {type: "STREAK_DAYS"|"TOTAL_COMPLETED"|..., value: number}
  createdAt        DateTime          @default(now())

  userAchievements UserAchievement[]
}

/// User's unlocked achievements.
model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

/// Per-user preferences.
model Settings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  theme              String   @default("system") // light | dark | system
  dailyReminderEnabled Boolean @default(false)
  dailyReminderTime  String?  @default("20:00") // HH:mm local
  dailyReminderChannel String @default("browser") // browser | email
  defaultTaskColor   String   @default("#6366f1")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

