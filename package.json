{
  "name": "god-watch",
  "version": "1.0.0",
  "private": true,
  "description": "God Watch — Every Day Leaves Evidence. A date-first habit tracker & daily checklist SaaS.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
