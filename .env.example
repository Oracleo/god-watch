# ============================================================
# God Watch — Environment Variables
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to version control.
# ============================================================

# ---- Next.js ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Auth.js (Google OAuth) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  {APP_URL}/api/auth/callback/google
AUTH_SECRET=generate-a-long-random-string-here
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_TRUST_HOST=true

# ---- Supabase PostgreSQL (via Prisma) ----
# Pooled connection string (transaction pooler) for serverless/Vercel:
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection string for local Prisma CLI/migrations:
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.supabase.com:5432/postgres"
DATABASE_URL=your-supabase-pooled-connection-string
DIRECT_URL=your-supabase-direct-connection-string

# ---- Optional: Cron secret for reminders ----
CRON_SECRET=your-cron-secret

